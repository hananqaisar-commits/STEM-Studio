{
  "headers": [
    {
      "source": "/robots.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain" }]
    },
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml" }]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!robots\\.txt|sitemap\\.xml|manifest\\.json|favicon\\.ico|icon-.*\\.png|apple-touch-icon\\.png|og-image\\.jpg).*)",
      "destination": "/index.html"
    }
  ]
}
