# Copy to deploy/scalability/.env and replace every placeholder.
# Generate secrets with: openssl rand -hex 32
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
JWT_SECRET_KEY=replace-with-a-long-random-secret
REDIS_PASSWORD=replace-with-a-long-random-hex-secret

# Set these to the real public frontend origin in a deployed environment.
CORS_ORIGINS=https://your-frontend.example
FRONTEND_URL=https://your-frontend.example

# Per API process. Estimate total DB connections as
# instances * workers * (pool size + max overflow).
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=1
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=300
UVICORN_WORKERS_PER_INSTANCE=1

# Redis stores only short-lived rate-limit counters, so persistence is off.
REDIS_KEY_PREFIX=stemstudio:ratelimit
REDIS_MAX_CONNECTIONS=100
REDIS_SOCKET_TIMEOUT_SECONDS=0.5
REDIS_RATE_LIMIT_FAIL_OPEN=true
PLATFORM_STATS_CACHE_SECONDS=30

# Local/staging ingress only. Put TLS termination in front of HAProxy in prod.
HTTP_PORT=8080
