# ─── Backend Environment Variables ───────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control!

# Database (Supabase PostgreSQL pooler/direct connection string)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# SQLAlchemy process-local pool. Capacity is per worker process; keep
# workers * (pool_size + max_overflow) within the database connection budget.
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=300
# Leave true for one API instance. In a replicated deployment, run one
# migration job and set this false on serving API instances.
AUTO_MIGRATE_ON_STARTUP=true

# Shared rate limits for multiple API processes/instances.
# Leave empty for local development (bounded in-memory rate limits).
REDIS_URL=
REDIS_KEY_PREFIX=stemstudio:ratelimit
REDIS_MAX_CONNECTIONS=100
REDIS_SOCKET_TIMEOUT_SECONDS=0.5
REDIS_RATE_LIMIT_FAIL_OPEN=true
PLATFORM_STATS_CACHE_SECONDS=30

# Supabase Project Credentials
SUPABASE_URL=https://[ref].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Set a strong random secret and keep the same value across API restarts and instances.
# Changing it invalidates all existing access and refresh tokens.
JWT_SECRET_KEY=change-this-to-a-secure-random-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_REMEMBER_ME_EXPIRE_DAYS=30
AUTH_REAUTH_MAX_AGE_MINUTES=10
OWNER_ACCESS_TOKEN_EXPIRE_MINUTES=10
OWNER_SESSION_MAX_HOURS=8
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required in staging/production; store in the backend host's secret manager.
OWNER_MFA_ENCRYPTION_KEY=
# For cross-site frontend/API hosting use SameSite=None + Secure=true and HTTPS.
OWNER_COOKIE_SECURE=true
OWNER_COOKIE_SAMESITE=none
# Learner email verification is disabled by default. Owner sign-in still requires a verified account.
EMAIL_VERIFICATION_REQUIRED=false
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=20
CORS_ORIGINS=["http://localhost:5173"]
DEBUG=false
# Keep false in staging/production. The backend honors this only with DEBUG=true.
ALLOW_UNVERIFIED_SIGNUP=false
# Deprecated and ignored. Owner access is granted only by the server-side provisioning command.
SUPPORT_OWNER_EMAILS=

# Public origin of the frontend — used to build password reset links.
FRONTEND_URL=http://localhost:5173
# Only enable behind a trusted reverse proxy that overwrites X-Forwarded-For.
TRUST_X_FORWARDED_FOR=false

# ─── Transactional email (Resend HTTPS API; account + owner email) ──
# Add a domain you own to Resend and publish the DNS records it provides.
# Render Free blocks outbound SMTP; the HTTPS API works over port 443.
# See docs/email-delivery-setup.md for DNS and Render setup.
# Email delivery is used for password resets, billing, and optional owner announcements.
# It is not required to create or sign into regular learner accounts unless
# EMAIL_VERIFICATION_REQUIRED=true.
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_secret_api_key
EMAILS_FROM_EMAIL=no-reply@your-verified-domain.example
EMAILS_FROM_NAME=STEM Studio
# Optional. Use an actual inbox or forwarding address if replies should arrive.
EMAILS_REPLY_TO=support@your-domain.example

# ─── Judge0 (Custom Code execution sandbox) ─────────────────────────
# Optional locally; required on the hosted backend to enable pasted-code runs.
# Keep the endpoint and secret on the FastAPI host, never in frontend/.env.
JUDGE0_URL=
# Configure Judge0 authentication on the service and use the matching secret.
# Judge0 CE's default authentication header is X-Auth-Token.
JUDGE0_API_KEY=
JUDGE0_AUTH_HEADER=X-Auth-Token
JUDGE0_TIMEOUT_SECONDS=20
JUDGE0_RATE_LIMIT_PER_MINUTE=20

# ─── Alibaba Cloud / Qwen (Octa AI Tutor) ──────────────────────────
# Get a free API key from Alibaba Cloud Model Studio (DashScope).
# Required for the Octa AI Tutor chat feature.
DASHSCOPE_API_KEY=your-dashscope-api-key
