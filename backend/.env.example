# ─── Backend Environment Variables ───────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control!

DATABASE_URL=mysql+pymysql://root:password@localhost/stem_studio
JWT_SECRET_KEY=change-this-to-a-secure-random-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["http://localhost:5173"]
DEBUG=false

# Public origin of the frontend — used to build password reset links.
FRONTEND_URL=http://localhost:5173

# ─── SMTP (password reset emails) ─────────────────────────────────
# REQUIRED for forgot-password to actually deliver email. Without these
# the API returns 503 and the reset link is only printed to the terminal.
# For Gmail: enable 2FA and generate an App Password
# (https://myaccount.google.com/apppasswords), then use it below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-char-app-password
