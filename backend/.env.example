# ─── Backend Environment Variables ───────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control!

# Database (Supabase PostgreSQL pooler/direct connection string)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Supabase Project Credentials
SUPABASE_URL=https://[ref].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
JWT_SECRET_KEY=change-this-to-a-secure-random-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["http://localhost:5173"]
DEBUG=false

# Public origin of the frontend — used to build password reset links.
FRONTEND_URL=http://localhost:5173

# ─── SMTP (password reset emails) ─────────────────────────────────
# REQUIRED for forgot-password to actually deliver email. Without these
# the API returns 503 and the reset link is only printed to the terminal.
# For Gmail: enable 2FA and generate an App Password
# (https://myaccount.google.com/apppasswords), then use it below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-char-app-password

# ─── Judge0 (Custom Code execution sandbox) ─────────────────────────
# REQUIRED for the Custom Code feature (paste-your-own algorithm body).
# Use any Judge0 CE instance: the public demo https://ce.judge0.com, or
# self-host with docker (https://github.com/judge0/judge0).
# Leave JUDGE0_URL empty to disable server-side execution.
JUDGE0_URL=
JUDGE0_API_KEY=
JUDGE0_TIMEOUT_SECONDS=20

# ─── Alibaba Cloud / Qwen (Octa AI Tutor) ──────────────────────────
# Get a free API key from Alibaba Cloud Model Studio (DashScope).
# Required for the Octa AI Tutor chat feature.
DASHSCOPE_API_KEY=your-dashscope-api-key

