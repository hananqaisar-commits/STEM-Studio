# ─── Backend Environment Variables ───────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control!

# Database (Supabase PostgreSQL pooler/direct connection string)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# SQLAlchemy process-local pool. Capacity is per worker process; keep
# workers * (pool_size + max_overflow) within the database connection budget.
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=300

# Shared rate limits for multiple API processes/instances.
# Leave empty for local development (bounded in-memory rate limits).
REDIS_URL=
REDIS_KEY_PREFIX=stemstudio:ratelimit
REDIS_MAX_CONNECTIONS=100
REDIS_SOCKET_TIMEOUT_SECONDS=0.5
REDIS_RATE_LIMIT_FAIL_OPEN=true
PLATFORM_STATS_CACHE_SECONDS=30

# Supabase Project Credentials
SUPABASE_URL=https://[ref].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
JWT_SECRET_KEY=change-this-to-a-secure-random-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_REMEMBER_ME_EXPIRE_DAYS=30
AUTH_REAUTH_MAX_AGE_MINUTES=10
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=20
CORS_ORIGINS=["http://localhost:5173"]
DEBUG=false

# Public origin of the frontend — used to build password reset links.
FRONTEND_URL=http://localhost:5173
# Only enable behind a trusted reverse proxy that overwrites X-Forwarded-For.
TRUST_X_FORWARDED_FOR=false

# ─── SMTP (password reset emails) ─────────────────────────────────
# REQUIRED for forgot-password to actually deliver email. Without these
# the API returns 503 and the reset link is only printed to the terminal.
# For Gmail: enable 2FA and generate an App Password
# (https://myaccount.google.com/apppasswords), then use it below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-char-app-password
EMAILS_FROM_EMAIL=noreply@example.com
EMAILS_FROM_NAME=STEM Studio Support

# ─── Judge0 (Custom Code execution sandbox) ─────────────────────────
# Optional locally; required on the hosted backend to enable pasted-code runs.
# Keep the endpoint and secret on the FastAPI host, never in frontend/.env.
JUDGE0_URL=
# Configure Judge0 authentication on the service and use the matching secret.
# Judge0 CE's default authentication header is X-Auth-Token.
JUDGE0_API_KEY=
JUDGE0_AUTH_HEADER=X-Auth-Token
JUDGE0_TIMEOUT_SECONDS=20
JUDGE0_RATE_LIMIT_PER_MINUTE=20

# ─── Alibaba Cloud / Qwen (Octa AI Tutor) ──────────────────────────
# Get a free API key from Alibaba Cloud Model Studio (DashScope).
# Required for the Octa AI Tutor chat feature.
DASHSCOPE_API_KEY=your-dashscope-api-key
